# Change theme
theme = dark:Gruvbox Dark,light:Gruvbox Light

# Enable shell integration
shell-integration = detect
shell-integration-features = no-cursor

# Change font
# Прошлые шрифты и их настройки — в README.md.
font-family = "Iosevka Nerd Font Mono"

font-size = 19
font-thicken = true
font-thicken-strength = 100

# Change cursor
cursor-style = block
cursor-style-blink = true

# Change window style
macos-titlebar-style = native
macos-titlebar-proxy-icon = visible
# left — Option+символ продолжает работать для спецсимволов через правый Option
macos-option-as-alt = left
# Правый Option на стрелках/спецклавишах слал бы macOS-композицию (ESC f / ESC b),
# что zellij видит как Alt+f → ToggleFloatingPanes. Жёстко шлём корректные CSI.
keybind = alt+right=text:\x1b[1;3C
keybind = alt+left=text:\x1b[1;3D
keybind = alt+up=text:\x1b[1;3A
keybind = alt+down=text:\x1b[1;3B

# Personal keybindings like iTerm2
keybind = cmd+left=previous_tab
keybind = cmd+right=next_tab
keybind = cmd+shift+left=move_tab:-1
keybind = cmd+shift+right=move_tab:1

# Quality of life
copy-on-select = true
mouse-hide-while-typing = true
confirm-close-surface = false
window-save-state = always
window-padding-x = 8
window-padding-y = 6
scrollback-limit = 10000000

# Window appearance
window-theme = auto
window-decoration = auto
background-opacity = 0.95
background-blur-radius = 20
